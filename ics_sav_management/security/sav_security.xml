<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_sav">
        <field name="name">After-Sales Service</field>
        <field name="sequence">55</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_sav">
        <field name="name">After-Sales Service</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="ics_sav_management.module_category_sav"/>
    </record>

    <record id="group_sav_salesman" model="res.groups">
        <field name="name">User: Own Documents Only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sav"/>
        <field name="comment">the user will have access to his own data in the SAV application.</field>
    </record>

    <record id="group_sav_salesman_all" model="res.groups">
        <field name="name">User: All Documents</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sav"/>
        <field name="comment">the user will have access to all records of everyone in the SAV application.</field>
    </record>

    <record id="group_sav_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="comment">the user will have an access to the sav configuration as well as statistic reports.
        </field>
        <field name="privilege_id" ref="res_groups_privilege_sav"/>
    </record>
</odoo>
