<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_sav" model="ir.ui.view">
        <field name="name">sale.order.view.form.sav.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']"
                   position="after">
                <field name="lot_id"
                       optional="show"
                       domain="[('product_id.product_tmpl_id', '=', product_template_id)]"/>
            </xpath>
        </field>
    </record>

</odoo>