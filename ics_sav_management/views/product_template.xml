<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_sav" model="ir.ui.view">
        <field name="name">product.template.view.form.sav.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="track_lifecycle"
                       invisible="not company_id.implement_sav_module or is_storable == False"/>
                <field name="warranty_type"
                       invisible="not track_lifecycle" options="{'no_create': True, 'no_edit': True , 'no_open': True }"/>
                <field name="warranty_limit"
                       invisible="not track_lifecycle"/>
            </xpath>

            <!-- Add Lifecycle tab to the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Cycle de vie" name="lifecycle" invisible="not track_lifecycle">
                    <field name="lifecycle_ids">
                        <list editable="bottom">
                            <field name="maintenance_type"/>
                            <field name="odometer_type"/>
                            <field name="odometer_value"/>
                            <field name="spare_parts_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>