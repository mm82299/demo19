<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sav_record_view_form" model="ir.ui.view">
        <field name="name">sav.record.view.form</field>
        <field name="model">sav.record</field>
        <field name="arch" type="xml">
            <form string="Dossier SAV">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Numéro de série…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations générales">
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="sale_order_id"/>
                            <field name="picking_id"/>
                            <field name="delivery_date"/>
                        </group>
                        <group string="Garantie">
                            <field name="warranty_type"/>
                            <field name="warranty_limit"
                                   invisible="warranty_type not in ('year','day')"/>
                            <field name="warranty_deadline"
                                   invisible="warranty_type not in ('year','day')"/>
                            <field name="odometer_current"
                                   invisible="warranty_type not in ('hour','km')"/>
                            <field name="warranty_validity" widget="badge"
                                   decoration-success="warranty_validity == 'valid'"
                                   decoration-danger="warranty_validity == 'expired'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cycle de vie SAV" name="lifecycle">
                            <field name="sav_lifecycle_ids">
                                <list editable="bottom">
                                    <field name="maintenance_type"/>
                                    <field name="odometer_type"/>
                                    <field name="odometer_value"/>
                                    <field name="odometer_real_value"/>
                                    <field name="spare_parts_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarques" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sav_record_view_list" model="ir.ui.view">
        <field name="name">sav.record.view.list</field>
        <field name="model">sav.record</field>
        <field name="arch" type="xml">
            <list string="Dossiers SAV"
                  decoration-success="warranty_validity == 'valid'"
                  decoration-danger="warranty_validity == 'expired'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="picking_id"/>
                <field name="delivery_date"/>
                <field name="warranty_type"/>
                <field name="warranty_deadline" optional="show"/>
                <field name="odometer_current" optional="show"/>
                <field name="warranty_validity" widget="badge"
                       decoration-success="warranty_validity == 'valid'"
                       decoration-danger="warranty_validity == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="sav_record_view_search" model="ir.ui.view">
        <field name="name">sav.record.view.search</field>
        <field name="model">sav.record</field>
        <field name="arch" type="xml">
            <search string="Recherche SAV">
                <field name="name" string="Numéro de série"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <separator/>
                <filter string="Garantie valide" name="valid"
                        domain="[('warranty_validity','=','valid')]"/>
                <filter string="Garantie expirée" name="expired"
                        domain="[('warranty_validity','=','expired')]"/>
                <group  name="Regrouper par">
                    <filter string="Produit" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Statut garantie" name="group_warranty"
                            context="{'group_by': 'warranty_validity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sav_record_action" model="ir.actions.act_window">
        <field name="name">Dossiers SAV</field>
        <field name="res_model">sav.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sav_record_view_search"/>
    </record>

</odoo>