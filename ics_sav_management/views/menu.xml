        sequence="1"/>

    <menuitem
        id="sav_menu_lifecycle_rules"
        name="Règles cycle de vie"
        parent="sav_menu_root"
        action="sav_action_lifecycle_rules"
        sequence="2"/>

    <menuitem
        id="sav_menu_config"
        name="Configuration"
