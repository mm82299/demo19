    <record id="sav_action_records" model="ir.actions.act_window">
        <field name="name">Dossiers SAV</field>
        <field name="res_model">sav.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="sav_action_lifecycle_rules" model="ir.actions.act_window">
        <field name="name">Règles cycle de vie (produits)</field>
        <field name="res_model">product.lifecycle.rule</field>
        <field name="view_mode">list,form</field>
    </record>

        <record id="warranty_type_action" model="ir.actions.act_window">
        <field name="name">Warranty type</field>
        <field name="res_model">warranty.type</field>
        <field name="view_mode">list</field>
    </record>

