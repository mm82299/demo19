<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sav" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sav.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"  ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Service Après-Vente" string="Service Après-Vente" name="ics_sav_management"  logo="/ics_sav_management/static/description/icon.png" >
                    <block title="SAV Management">
                        <setting string="SAV Module"
                                 help="Activate product lifecycle tracking, warranty management, and customs traceability.">
                            <field name="implement_sav_module"/>
                            <label for="implement_sav_module" string="Activate SAV Module"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>