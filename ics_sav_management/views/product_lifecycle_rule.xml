<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="product_lifecycle_rule_view_form" model="ir.ui.view">
        <field name="name">product.lifecycle.rule.view.form</field>
        <field name="model">product.lifecycle.rule</field>
        <field name="arch" type="xml">
            <form string="Product_lifecycle_rule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="maintenance_type"/>
                            <field name="odometer_type"/>
                        </group>
                        <group>
                            <field name="spare_parts_ids" widget="many2many_tags"/>
                            <field name="odometer_value"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="product_lifecycle_rule_view_list" model="ir.ui.view">
        <field name="name">product.lifecycle.rule.view.list</field>
        <field name="model">product.lifecycle.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="maintenance_type"/>
                <field name="odometer_type"/>
                <field name="odometer_value"/>
                <field name="spare_parts_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
</odoo>