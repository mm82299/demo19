<?xml version="1.0"  ?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for account withholding vente -->
        <record id="seq_account_withholding" model="ir.sequence">
            <field name="name">Account withholding</field>
            <field name="code">account.withholding</field>
            <field name="prefix">RETENUE/VENTE/%(range_year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- Sequence for account withholding achat -->
        <record id="seq_account_withholding_achat_type" model="ir.sequence">
            <field name="name">Account withholding</field>
            <field name="code">account.withholding.achat</field>
            <field name="prefix">RETENUE/ACHAT/%(range_year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>