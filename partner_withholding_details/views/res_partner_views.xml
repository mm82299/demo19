<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View -->
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.withholding.config</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add fields to an existing group -->
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="customer_account_withholding" invisible="not is_customer"/>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="vendor_account_withholding" invisible="not is_supplier"/>
            </xpath>

        </field>
    </record>
</odoo>