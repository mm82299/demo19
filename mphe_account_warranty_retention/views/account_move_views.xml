<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_warranty" model="ir.ui.view">
        <field name="name">account.move.form.inherit.warranty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_apply_warranty_retention_ht" 
                        string="Retenue Garantie (10% HT)" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <button name="action_apply_warranty_retention_ttc" 
                        string="Retenue Garantie (10% TTC)" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
