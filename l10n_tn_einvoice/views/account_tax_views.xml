<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Account Tax Form View -->
    <record id="view_account_tax_form_ttn" model="ir.ui.view">
        <field name="name">account.tax.form.ttn</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group name="ttn_config" string="Configuration TEIF/TTN">
                    <field name="ttn_code" />
                    <field name="ttn_tax_category" invisible="not ttn_code" />
                </group>
            </xpath>
        </field>
    </record>
    <!-- Inherit Account Tax Tree View -->
    <record id="view_account_tax_tree_ttn" model="ir.ui.view">
        <field name="name">account.tax.tree.ttn</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <field name="ttn_code" optional="hide" />
            </xpath>
        </field>
    </record>
    <!-- Search View for Taxes with TTN Code -->
    <record id="view_account_tax_search_ttn" model="ir.ui.view">
        <field name="name">account.tax.search.ttn</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_account_tax_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_ttn_taxes" string="Taxes TTN" domain="[('ttn_code', '!=', False)]" />
                <group>
                    <filter name="group_ttn_code" string="Code TTN" context="{'group_by': 'ttn_code'}" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>