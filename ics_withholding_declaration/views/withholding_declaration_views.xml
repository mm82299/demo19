        <record id="withholding_declaration_act_window" model="ir.actions.act_window">
            <field name="name">Withholding Declaration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">withholding.declaration</field>
            <field name="view_mode">list,form</field>
        </record>


