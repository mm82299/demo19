<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="withholding_declaration_operation_type_form_view" model="ir.ui.view">
            <field name="name">withholding.declaration.operation.type.form</field>
            <field name="model">withholding.declaration.operation.type</field>
            <field name="arch" type="xml">
                <form string="Operation Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="active"/>
                                <field name="rate" force_save="1"/>
                                <field name="code" force_save="1"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="description" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="withholding_declaration_operation_type_tree_view" model="ir.ui.view">
            <field name="name">withholding.declaration.operation.type.tree</field>
            <field name="model">withholding.declaration.operation.type</field>
            <field name="arch" type="xml">
                <list string="Operation Type" editable="top">
                    <field name="name"/>
                    <field name="rate"/>
                    <field name="active"/>
                    <field name="category_id"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="withholding_declaration_operation_type_act_window" model="ir.actions.act_window">
            <field name="name">Operation Type Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">withholding.declaration.operation.type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>