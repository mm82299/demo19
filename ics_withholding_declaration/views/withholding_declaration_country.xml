<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="withholding_declaration_country_form_view" model="ir.ui.view">
            <field name="name">withholding.declaration.country.form</field>
            <field name="model">withholding.declaration.country</field>
            <field name="arch" type="xml">
                <form string="Declaration Country">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
                </form>
            </field>
        </record>

      <record id="withholding_declaration_country_tree_view" model="ir.ui.view">
            <field name="name">withholding.declaration.country.tree</field>
            <field name="model">withholding.declaration.country</field>
            <field name="arch" type="xml">
                <list string="Declaration Country">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
      </record>

       <record id="withholding_declaration_country_act_window" model="ir.actions.act_window">
            <field name="name">Declaration Country</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">withholding.declaration.country</field>
            <field name="view_mode">list,form</field>
       </record>
    </data>
</odoo>