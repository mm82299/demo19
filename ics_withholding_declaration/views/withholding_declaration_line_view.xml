<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="withholding_declaration_line_form_view" model="ir.ui.view">
            <field name="name">withholding_declaration.line.form</field>
            <field name="model">withholding.declaration.line</field>
            <field name="arch" type="xml">
                <form string="Withholding Declaration Line">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="declaration_id"/>
                                <field name="declaration_id_edit"/>
                                <field name="declaration_id_delete"/>
                                <field name="withholding_id"/>
                                <field name="tax_id_type"/>
                                <field name="tax_id"/>
                                <field name="birth_date"/>
                            </group>
                            <group>
                                <field name="category_type"/>
                                <field name="country_id"/>
                                <field name="partner_tunisian"/>
                                <field name="partner_full_name"/>
                                <field name="partner_address"/>
                                <field name="partner_activity"/>
                                <field name="partner_mail"/>
                                <field name="partner_phone"/>
                                <field name="payment_date"/>
                                <field name="ref_certificate"/>
                                <field name="ref_certificate"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="total_amount_ht"/>
                                <field name="total_amount_tva"/>
                                <field name="total_amount_ttc"/>
                                <field name="total_amount_rs"/>
                                <field name="total_taxes"/>
                                <field name="total_amount_amount_servi"/>
                            </group>
                            <group>
                                <field name="total_amount_devise"/>
                                <field name="total_amount_devise_rs"/>
                                <field name="total_amount_devise_ttc"/>
                                <field name="total_amount_devise_servi"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Operation Line">
                                <field name="operation_line_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="withholding_declaration_line_tree_view" model="ir.ui.view">
            <field name="name">withholding.declaration.line.tree</field>
            <field name="model">withholding.declaration.line</field>
            <field name="arch" type="xml">
                <list string="Withholding Declaration line">
                    <field name="name"/>
                    <field name="tax_id_type"/>
                    <field name="tax_id"/>
                    <field name="birth_date"/>
                    <field name="category_type"/>
                    <field name="country_id"/>
                    <field name="partner_tunisian"/>
                    <field name="partner_full_name"/>
                    <field name="partner_address"/>
                    <field name="partner_activity"/>
                    <field name="partner_mail"/>
                    <field name="partner_phone"/>
                    <field name="payment_date"/>
                    <field name="ref_certificate"/>
                    <field name="total_amount_ht"/>
                    <field name="total_amount_tva"/>
                    <field name="total_amount_ttc"/>
                    <field name="total_amount_rs"/>
                    <field name="total_taxes"/>
                    <field name="total_amount_amount_servi"/>
                    <field name="total_amount_devise"/>
                    <field name="total_amount_devise_rs"/>
                    <field name="total_amount_devise_ttc"/>
                    <field name="total_amount_devise_servi"/>
                </list>
            </field>
        </record>
        <record id="withholding_declaration_line_search_view" model="ir.ui.view">
            <field name="name">withholding.declaration.line.search</field>
            <field name="model">withholding.declaration.line</field>
            <field name="arch" type="xml">
                <search string="Withholding Declaration Line">
                    <field name="name"/>
                    <group>
                        <filter string="Declaration" name="declaration_id" domain="[]"
                                context="{'group_by':'declaration_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="withholding_declaration_line_act_window" model="ir.actions.act_window">
            <field name="name">Withholding Declaration Line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">withholding.declaration.line</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>