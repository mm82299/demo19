<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Héritage de la vue form de account.payment -->
    <record id="view_account_payment_form_inherit_traite" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.traite</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Ajout du champ is_traite_payment en invisible -->
            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="is_traite_payment" invisible="1"/>
            </xpath>
            
            <!-- Ajout des champs Date d'échéance et Numéro de traite -->
            <xpath expr="//field[@name='date']" position="after">
                <field name="traite_due_date" 
                       invisible="not is_traite_payment" 
                       readonly="state != 'draft'"/>
                <field name="traite_number" 
                       invisible="not is_traite_payment" 
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- Héritage de la vue form de account.payment.register (Wizard) -->
    <record id="view_account_payment_register_form_inherit_traite" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.traite</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- Ajout du champ is_traite_payment en invisible -->
            <xpath expr="//field[@name='payment_date']" position="before">
                <field name="is_traite_payment" invisible="1"/>
            </xpath>

            <!-- Ajout des champs Date d'échéance et Numéro de traite -->
            <xpath expr="//field[@name='payment_date']" position="after">
                <field name="traite_due_date" 
                       invisible="not is_traite_payment"/>
                <field name="traite_number" 
                       invisible="not is_traite_payment"/>
            </xpath>
        </field>
    </record>

</odoo>
