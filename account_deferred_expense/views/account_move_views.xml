<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════
         account.move.line list view — add Deferred Date range column
         Mirrors Enterprise view_move_line_tree extension
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_move_line_tree_deferred_expense" model="ir.ui.view">
        <field name="name">account.move.line.list.deferred.expense</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="has_deferred_moves" column_invisible="True"/>
            </xpath>
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="deferred_start_date"
                       string="Deferred Date"
                       widget="daterange"
                       options="{'end_date_field': 'deferred_end_date', 'always_range': True}"
                       optional="hide"
                       readonly="has_deferred_moves"/>
                <field name="deferred_end_date"
                       required="deferred_start_date"
                       column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         account.move form — smart buttons + invoice line columns
         Mirrors Enterprise view_move_form_inherit
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_move_form_deferred_expense" model="ir.ui.view">
        <field name="name">account.move.form.deferred.expense</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="deferred_move_ids" invisible="1"/>
                <field name="deferred_original_move_ids" invisible="1"/>
                <field name="deferred_entry_type" invisible="1"/>

                <!-- On originating bill: show "Deferral Entries" -->
                <button name="open_deferred_entries"
                        class="oe_stat_button"
                        icon="fa-calendar-o"
                        type="object"
                        invisible="not deferred_move_ids"
                        string="Deferral Entries"/>

                <!-- On deferral move: show "Related Purchase(s)" -->
                <button name="open_deferred_original_entry"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        type="object"
                        invisible="deferred_entry_type != 'expense' or not deferred_original_move_ids"
                        string="Related Purchase(s)"/>
            </xpath>

            <!-- Deferred date range column on invoice lines tab -->
            <xpath expr="//page[@id='invoice_tab']//list/field[@name='analytic_distribution']"
                   position="after">
                <field name="deferred_start_date"
                       string="Deferred Date"
                       widget="daterange"
                       options="{'end_date_field': 'deferred_end_date', 'always_range': True}"
                       optional="show"
                       decoration-warning="has_abnormal_deferred_dates"/>
                <field name="deferred_end_date"
                       required="deferred_start_date"
                       column_invisible="1"/>
                <field name="has_abnormal_deferred_dates" column_invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Dedicated Deferred Entries list view (opened from smart button)
         Mirrors Enterprise view_deferred_entries_tree
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_deferred_expense_entries_tree" model="ir.ui.view">
        <field name="name">account.move.line.deferred.expense.entries.list</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_currency']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

</odoo>
