<odoo>
    <data>
        <record id="account_withholding_tva_tax_view_tree" model="ir.ui.view">
            <field name="name">account.withholding.tva.tax.tree</field>
            <field name="model">account.withholding.tva.tax</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="type_withholding"/>
                    <field name="rate"/>
                </list>
            </field>
        </record>

        <record id="account_withholding_tva_tax_view_form" model="ir.ui.view">
            <field name="name">account.withholding.tva.tax.form</field>
            <field name="model">account.withholding.tva.tax</field>
            <field name="arch" type="xml">
                <form string="Retenue à la source">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="rate" class="oe_inline"/>
                                <field name="journal_id"/>

                            </group>
                            <group>
                                <field name="account_id"/>
                                <field name="refund_account_id"/>
                                <field name="type_withholding"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter reload_on_post="True" reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="account_withholding_tva_tax_action" model="ir.actions.act_window">
            <field name="name">Retenue à la source TVA</field>
            <field name="res_model">account.withholding.tva.tax</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="account_withholding_tva_tax_menu" name="Retenue à la source de TVA"
                  parent="account.account_invoicing_menu"
                  action="account_withholding_tva_tax_action"
                  groups="account.group_account_manager"/>
    </data>
</odoo>
