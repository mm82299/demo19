<odoo>
    <data>
        <!--Customer Withholding-->
        <record id="account_withholding_tva_customer_view_tree" model="ir.ui.view">
            <field name="name">account.withholding.tva.customer.tree</field>
            <field name="model">account.withholding.tva</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="partner_id" string="Client"/>
                    <field name="date"/>
                    <field name="journal_id"/>
                    <field name="state"/>
                    <field name="tax"/>
                    <field name="retenue_amount"/>
                </list>
            </field>
        </record>

        <record id="account_withholding_tva_customer_view_form" model="ir.ui.view">
            <field name="name">account.withholding.tva.customer.form</field>
            <field name="model">account.withholding.tva</field>
            <field name="arch" type="xml">
                <form edit="state == 'draft'">
                    <header>
                        <button name="button_validate_withholding" string="Valider" type="object"
                                invisible="state not in ('draft')"
                                class="oe_highlight o_invoice_validate"/>
                        <button name="button_cancel" string="Remettre en Brouillon" class="btn-default" type="object"
                                invisible="state not in ('cancel')"/>
                        <button name="button_draft" string="Annuler" class="btn-default" type="object"
                                invisible="state in ('draft', 'cancel')"/>
                        <field name="state" widget="statusbar" nolabel="1"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="button_account_move" string="Écritures comptables"
                                    type="object" groups="account.group_account_user"
                                    invisible="not account_move_id" icon="fa-bars"/>
                            <field name="account_move_id" invisible="1"/>
                        </div>
                        <widget name="web_ribbon" title="Fait" invisible="state in ('draft', 'cancel')"/>
                        <widget name="web_ribbon" title="Annulée" bg_color="bg-danger" invisible="state in ('draft', 'done')"/>
                        <group>
                            <group>
                                <field name="partner_id" string="Client"
                                       readonly="state == 'done'" widget="many2one"
                                       context="{'show_address': 1, 'default_is_company': True, 'show_vat': True}"
                                       options="{&quot;always_reload&quot;: True, &quot;no_quick_create&quot;: True}"/>
                                <field name="account_withholding_tax_ids" widget="many2one"
                                       readonly="state == 'done'"
                                       domain="[('type_withholding','=','vente')]" />
                                <field name="journal_id" readonly="state in ('done', 'cancel')" domain="[('type','=', 'general')]"/>
                            </group>
                            <group>
                                <field name="type" value='out_withholding' invisible="1"/>
                                <field name="date" readonly="state == 'done'" />
                                <field name="amount_total_rs"/>
                            </group>
                        </group>
                        <group>
                            <field name="account_invoice_ids" widget="many2many" nolabel="1"
                                   domain="[('partner_id','=',partner_id),('payment_state', 'in', ('not_paid', 'partial')),('move_type','in',('out_refund','out_invoice')),('state','=', 'posted'),('withholding_tva_id','=',False)]"
                                   readonly="state == 'done'" />
                            <group>
                                <field name="retenue_amount"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter reload_on_post="True" reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="account_withholding_tva_customer_action" model="ir.actions.act_window">
            <field name="name">RS TVA Client</field>
            <field name="res_model">account.withholding.tva</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type','=','out_withholding')]</field>
            <field name="context">{'default_type': 'out_withholding'}</field>
        </record>

        <record id="account_withholding_tva_customer_action_tree" model="ir.actions.act_window.view">
            <field name="view_mode">list</field>
            <field name="view_id" ref="account_withholding_tva_customer_view_tree"/>
            <field name="act_window_id" ref="account_withholding_tva_customer_action"/>
        </record>

        <record id="account_withholding_tva_customer_action_form" model="ir.actions.act_window.view">
            <field name="view_mode">form</field>
            <field name="view_id" ref="account_withholding_tva_customer_view_form"/>
            <field name="act_window_id" ref="account_withholding_tva_customer_action"/>
        </record>

        <menuitem id="account_withholding_tva_customer_menu" name="RS TVA Client"
                  parent="account.menu_finance_receivables"
                  action="account_withholding_tva_customer_action"
                  groups="account.group_account_user,account.group_account_manager,account.group_account_invoice"/>


    </data>
</odoo>
