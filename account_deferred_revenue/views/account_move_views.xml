<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════
         account.move form — smart buttons for revenue deferral
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_move_form_deferred_revenue" model="ir.ui.view">
        <field name="name">account.move.form.deferred.revenue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="deferred_revenue_move_ids" invisible="1"/>
                <field name="deferred_revenue_original_move_ids" invisible="1"/>
                <field name="is_deferred_revenue_entry" invisible="1"/>

                <!-- On originating invoice: show "Deferral Entries" -->
                <button name="open_deferred_revenue_entries"
                        class="oe_stat_button"
                        icon="fa-calendar-o"
                        type="object"
                        invisible="not deferred_revenue_move_ids"
                        string="Deferral Entries"/>

                <!-- On deferral move: show "Related Sale(s)" -->
                <button name="open_deferred_revenue_original_entry"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        type="object"
                        invisible="not is_deferred_revenue_entry or not deferred_revenue_original_move_ids"
                        string="Related Sale(s)"/>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Dedicated Deferred Revenue Entries list view
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_deferred_revenue_entries_tree" model="ir.ui.view">
        <field name="name">account.move.line.deferred.revenue.entries.list</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_currency']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

</odoo>
