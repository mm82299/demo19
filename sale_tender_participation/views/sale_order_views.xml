<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_sale_tender" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sale.tender</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="tender_participation_id" options="{'no_create': True}" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>