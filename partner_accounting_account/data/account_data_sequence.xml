<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="receivable_account_sequence" model="ir.sequence">
            <field name="name">Receivable Account Sequence</field>
            <field name="code">receivable.account.seq</field>
            <field name="prefix">411</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="payable_account_sequence" model="ir.sequence">
            <field name="name">Payable Account Sequence</field>
            <field name="code">payable.account.seq</field>
            <field name="prefix">401</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>