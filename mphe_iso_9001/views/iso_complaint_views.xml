<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso_complaint_form" model="ir.ui.view">
        <field name="name">iso.complaint.form</field>
        <field name="model">iso.complaint</field>
        <field name="arch" type="xml">
            <form string="Customer Complaint">
                <header>
                    <button name="action_investigate" string="Investigate" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_resolve" string="Resolve" type="object" invisible="state != 'investigating'" class="oe_highlight"/>
                    <button name="action_validate" string="Validate &amp; Close" type="object" invisible="state != 'resolving'" class="oe_highlight"/>
                    <button name="action_close" string="Close Permanent" type="object" invisible="state != 'validating'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,investigating,resolving,validating,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="subject"/>
                            <field name="reception_date"/>
                            <field name="reception_mode"/>
                        </group>
                        <group>
                            <field name="action_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Curative Action">
                            <field name="immediate_correction"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_iso_complaint_tree" model="ir.ui.view">
        <field name="name">iso.complaint.tree</field>
        <field name="model">iso.complaint</field>
        <field name="arch" type="xml">
            <tree string="Customer Complaints">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reception_date"/>
                <field name="subject"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_iso_complaint" model="ir.actions.act_window">
        <field name="name">Customer Complaints Register</field>
        <field name="res_model">iso.complaint</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
