<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_iso_action" model="ir.sequence">
            <field name="name">ISO Action Sequence</field>
            <field name="code">iso.action</field>
            <field name="prefix">CAR/%(year)s/</field>
            <field name="padding">3</field>
        </record>

        <record id="seq_iso_audit" model="ir.sequence">
            <field name="name">ISO Audit Sequence</field>
            <field name="code">iso.audit</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">3</field>
        </record>

        <record id="seq_iso_complaint" model="ir.sequence">
            <field name="name">ISO Complaint Sequence</field>
            <field name="code">iso.complaint</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">3</field>
        </record>
    </data>
</odoo>
