    <!-- Action -->
    <record id="action_customer_clam" model="ir.actions.act_window">
        <field name="name">Réclamations Clients</field>
        <field name="res_model">customer.clam</field>
        <field name="view_mode">list,form</field>
<!--        <field name="search_view_id" ref="view_customer_clam_search"/>-->
