<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_customer_clam_list" model="ir.ui.view">
        <field name="name">customer.clam.list</field>
        <field name="model">customer.clam</field>
        <field name="arch" type="xml">
            <list string="Réclamations Clients" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state == 'closed'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="date_limit"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state == 'closed'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_customer_clam_form" model="ir.ui.view">
        <field name="name">customer.clam.form</field>
        <field name="model">customer.clam</field>
        <field name="arch" type="xml">
            <form string="Réclamation Client">
                <header>
                    <button name="action_in_progress" string="Commencer" type="object" class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_closed" string="Clôturer" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_rejected" string="Rejeter" type="object" invisible="state not in ['new', 'in_progress']"/>
                    <button name="action_draft" string="Remettre en Brouillon" type="object" invisible="state not in ['closed', 'rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="date_limit"/>
                        </group>
                        <group>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="num_nc_file"/>
                            <field name="date_close" invisible="state != 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détails" name="details">
                            <group>
                                <field name="description" placeholder="Description de la réclamation..."/>
                                <field name="action" placeholder="Action corrective/préventive..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

