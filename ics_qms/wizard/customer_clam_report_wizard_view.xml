<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_clam_report_wizard_form" model="ir.ui.view">
        <field name="name">customer.clam.report.wizard.form</field>
        <field name="model">customer.clam.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Analyse des réclamations">
                <group>
                    <group>
                        <field name="date_start"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Générer Excel" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_clam_report_wizard" model="ir.actions.act_window">
        <field name="name">Analyse des réclamations</field>
        <field name="res_model">customer.clam.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu under Sale/Reporting (Analyse) -->
    <menuitem id="menu_sale_report_customer_clam"
              name="Analyse des réclamations"
              parent="sale.menu_sale_report"
              action="action_customer_clam_report_wizard"
              sequence="50"/>
</odoo>
