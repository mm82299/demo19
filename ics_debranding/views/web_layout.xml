<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_debranding" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'ICS ERP'" />
        </xpath>
    </template>

    <template id="login_layout_debranding" inherit_id="web.login_layout">
        <xpath expr="//div[@t-if='not disable_footer']" position="replace">
            <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                <t t-if="not disable_database_manager">
                    <a class="border-end pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                </t>
                <a href="https://ics-tunisie.com" target="_blank">Powered by <span>ICS</span></a>
            </div>
        </xpath>
    </template>
</odoo>