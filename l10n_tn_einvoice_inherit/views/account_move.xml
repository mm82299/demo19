<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_teif_inherit_desc" model="ir.ui.view">
        <field name="name">account.move.form.teif.desc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="public_company" invisible="True" />
                <field name="teif_description" invisible="not public_company" required="public_company"/>
            </xpath>
        </field>
    </record>
</odoo>