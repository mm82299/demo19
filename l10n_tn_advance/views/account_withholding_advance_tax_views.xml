<odoo>
    <data>
        <record id="account_withholding_advance_tax_view_tree" model="ir.ui.view">
            <field name="name">account.withholding.advance.tax.tree</field>
            <field name="model">account.withholding.advance.tax</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="type_withholding"/>
                    <field name="rate"/>
                </list>
            </field>
        </record>

        <record id="account_withholding_advance_tax_view_form" model="ir.ui.view">
            <field name="name">account.withholding.advance.tax.form</field>
            <field name="model">account.withholding.advance.tax</field>
            <field name="arch" type="xml">
                <form string="Configuration de la Retenue">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="rate"/>
                                <field name="journal_id" domain="[('type', '=', 'general')]"/>
                            </group>
                            <group>
                                <field name="account_id"/>
                                <field name="refund_account_id"/>
                                <field name="type_withholding"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="account_withholding_advance_tax_action" model="ir.actions.act_window">
            <field name="name">Types de Retenue d'Avance</field>
            <field name="res_model">account.withholding.advance.tax</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="account_withholding_advance_tax_menu" 
                  name="Types de Retenue d'Avance"
                  parent="account.account_account_menu"
                  action="account_withholding_advance_tax_action"
                  sequence="20"
                  groups="account.group_account_manager"/>
    </data>
</odoo>
