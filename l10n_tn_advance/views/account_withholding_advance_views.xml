<odoo>
    <data>
        <record id="account_withholding_advance_view_tree" model="ir.ui.view">
            <field name="name">account.withholding.advance.list</field>
            <field name="model">account.withholding.advance</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="tax_id"/>
                    <field name="retenue_amount" sum="Total Retenue"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <record id="account_withholding_advance_view_form" model="ir.ui.view">
            <field name="name">account.withholding.advance.form</field>
            <field name="model">account.withholding.advance</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_validate_withholding" string="Valider" type="object"
                                invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="button_draft" string="Remettre en Brouillon" type="object"
                                invisible="state != 'cancel'"/>
                        <button name="button_cancel" string="Annuler" type="object"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="button_account_move" 
                                    type="object" icon="fa-bars" string="Journal Entry"
                                    invisible="not account_move_id"/>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" readonly="state != 'draft'"/>
                                <field name="tax_id" readonly="state != 'draft'"/>
                                <field name="journal_id" groups="base.group_no_one"/>
                            </group>
                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="amount_total_rs"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="account_move_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Factures" name="invoices">
                                <field name="invoice_ids" readonly="state != 'draft'"
                                       domain="[('partner_id', '=', partner_id), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]">
                                    <list>
                                        <field name="name"/>
                                        <field name="invoice_date"/>
                                        <field name="amount_total" sum="Total Invoices"/>
                                        <field name="payment_state" widget="badge"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="retenue_amount" class="oe_subtotal_footer_separator"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="account_withholding_advance_action" model="ir.actions.act_window">
            <field name="name">Retenue de garantie (Ventes)</field>
            <field name="res_model">account.withholding.advance</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'out_withholding')]</field>
            <field name="context">{'default_type': 'out_withholding'}</field>
        </record>

        <menuitem id="account_withholding_advance_menu" 
                  name="Retenues de garantie"
                  parent="account.menu_finance_receivables"
                  action="account_withholding_advance_action"
                  sequence="20"
                  groups="account.group_account_user"/>
    </data>
</odoo>
