<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_state" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="after">
                <field name="state_id"/>
            </field>
        </field>
    </record>

    <record id="view_order_tree_inherit_state" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_state" model="ir.ui.view">
        <field name="name">sale.quotation.tree.inherit.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_state" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Planning Pivot View -->
    <record id="view_sale_order_pivot_inherit_state" model="ir.ui.view">
        <field name="name">sale.order.pivot.inherit.state</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Planning by State" sample="1">
                <field name="state_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Planning Graph View -->
    <record id="view_sale_order_graph_inherit_state" model="ir.ui.view">
        <field name="name">sale.order.graph.inherit.state</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Planning by State" type="bar" sample="1">
                <field name="state_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Update Action to include Pivot and Graph -->
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
</odoo>
