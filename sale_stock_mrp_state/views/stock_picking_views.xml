<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id"/>
            </field>
        </field>
    </record>

    <record id="vpicktree_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id" optional="show"/>
                <field name="total_weight_demanded" sum="Total Poids Demandé" optional="show"/>
                <field name="total_weight_done" sum="Total Poids Réalisé" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_picking_internal_search_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Planning Pivot View -->
    <record id="view_picking_pivot_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.pivot.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="Planning by State" sample="1">
                <field name="state_id" type="row"/>
                <field name="scheduled_date" interval="month" type="col"/>
                <field name="total_weight_demanded" type="measure"/>
                <field name="total_weight_done" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Planning Graph View -->
    <record id="view_picking_graph_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.graph.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <graph string="Planning by State" type="bar" sample="1">
                <field name="state_id"/>
                <field name="total_weight_done" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Update Action to include Pivot and Graph -->
    <record id="stock.action_picking_tree_all" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
</odoo>
