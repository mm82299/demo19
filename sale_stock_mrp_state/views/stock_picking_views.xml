<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id"/>
            </field>
        </field>
    </record>

    <record id="vpicktree_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_picking_internal_search_inherit_state" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
