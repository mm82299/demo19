<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_state" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.state</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="state_id"/>
                <field name="total_weight"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit_state" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.state</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="state_id" optional="show"/>
                <field name="total_weight" sum="Total Weight" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_mrp_production_filter_inherit_state" model="ir.ui.view">
        <field name="name">mrp.production.search.inherit.state</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Planning Pivot View -->
    <record id="view_mrp_production_pivot_inherit_state" model="ir.ui.view">
        <field name="name">mrp.production.pivot.inherit.state</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Planning by State" sample="1">
                <field name="state_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="product_qty" type="measure"/>
                <field name="total_weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Planning Graph View -->
    <record id="view_mrp_production_graph_inherit_state" model="ir.ui.view">
        <field name="name">mrp.production.graph.inherit.state</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <graph string="Planning by State" type="bar" sample="1">
                <field name="state_id"/>
                <field name="total_weight" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Update Action to include Pivot and Graph -->
    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
</odoo>
