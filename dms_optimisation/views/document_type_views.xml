<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_document_type_tree" model="ir.ui.view">
        <field name="name">dms.document.type.tree</field>
        <field name="model">dms.document.type</field>
        <field name="arch" type="xml">
            <list string="Types de Documents" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">dms.document.type.form</field>
        <field name="model">dms.document.type</field>
        <field name="arch" type="xml">
            <form string="Type de Document">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_type" model="ir.actions.act_window">
        <field name="name">Types de Documents</field>
        <field name="res_model">dms.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
