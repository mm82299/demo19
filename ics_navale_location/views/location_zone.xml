<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_zone_list" model="ir.ui.view">
        <field name="name">location.zone.list</field>
        <field name="model">location.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="floor_type"/>
                <field name="base_price"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-danger="state == 'occupied'" decoration-info="state == 'reserved'" decoration-warning="state == 'maintenance'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_location_zone_form" model="ir.ui.view">
        <field name="name">location.zone.form</field>
        <field name="model">location.zone</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Location Name"/>
                        </h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="floor_type"/>
                            <field name="max_length"/>
                            <field name="max_width"/>
                            <field name="has_electricity"/>

                        </group>
                        <group>
                            <field name="has_water"/>
                          <field name="base_price"/>
                            <field name="price_per_meter"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description of the location..."/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Rentals" name="rentals">
                            <field name="rental_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="boat_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_location_zone_kanban" model="ir.ui.view">
        <field name="name">location.zone.kanban</field>
        <field name="model">location.zone</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="color"/>
                <field name="floor_type"/>
                <field name="max_length"/>
                <field name="max_width"/>
                <field name="base_price"/>
                <field name="has_electricity"/>
                <field name="has_water"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_{{record.color.raw_value or 0}} oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="floor_type"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fa fa-arrows-h me-1" role="img" aria-label="Dimensions" title="Dimensions"/>
                                        <t t-esc="record.max_length.raw_value or ''"/>m x <t t-esc="record.max_width.raw_value or ''"/>m
                                    </div>
                                    <div class="col-6 text-end">
                                        <i class="fa fa-money me-1" role="img" aria-label="Price" title="Price per day"/>
                                        <t t-esc="record.base_price.raw_value or '0'"/>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-12">
                                        <t t-if="record.has_electricity.raw_value">
                                            <i class="fa fa-bolt text-warning me-1" title="Electricity"/>
                                        </t>
                                        <t t-if="record.has_water.raw_value">
                                            <i class="fa fa-tint text-info me-1" title="Water"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state"
                                           widget="label_selection"
                                           options="{'classes': {
                                               'available': 'success',
                                               'occupied': 'danger',
                                               'reserved': 'info',
                                               'maintenance': 'warning'
                                           }}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_location_zone" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">location.zone</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
