<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boat_list" model="ir.ui.view">
        <field name="name">res.boat.list</field>
        <field name="model">res.boat</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" class="oe_avatar" width="40" height="40"/>
                <field name="name"/>
                <field name="registration"/>
                <field name="partner_id"/>
                <field name="length"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_boat_kanban" model="ir.ui.view">
        <field name="name">res.boat.kanban</field>
        <field name="model">res.boat</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="length"/>
                <field name="registration"/>
                <field name="image"/>
                <field name="rental_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image" widget="image" class="o_kanban_image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="registration"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-8">
                                            <i class="fa fa-user me-1" role="img" aria-label="Owner"/>
                                            <field name="partner_id"/>
                                        </div>
                                        <div class="col-4 text-end">
                                            <i class="fa fa-arrows-v me-1" role="img" aria-label="Length"/>
                                            <field name="length"/>m
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <i class="fa fa-anchor me-1"/>
                                        <t t-esc="record.rental_count.raw_value or '0'"/> rental(s)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_boat_form" model="ir.ui.view">
        <field name="name">res.boat.form</field>
        <field name="model">res.boat</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_rental)d" type="action" class="oe_stat_button" icon="fa-anchor">
                            <field name="rental_count" widget="statinfo" string="Rentals"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Boat Name"/>
                        <h1>
                            <field name="name" placeholder="Boat Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="registration"/>
                            <field name="length"/>
                        </group>
<!--                        <group>-->
<!--              -->
<!--                        </group>-->
                    </group>
                    <group>
                        <field name="description" placeholder="Additional notes about the boat..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_boat" model="ir.actions.act_window">
        <field name="name">Boats</field>
        <field name="res_model">res.boat</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
