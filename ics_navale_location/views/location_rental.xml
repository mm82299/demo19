<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_tree" model="ir.ui.view">
        <field name="name">location.rental.list</field>
        <field name="model">location.rental</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <field name="boat_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration"/>
                <field name="price_per_day" widget="monetary"/>
                <field name="amount_total" widget="monetary"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rental_form" model="ir.ui.view">
        <field name="name">location.rental.form</field>
        <field name="model">location.rental</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_in_progress" string="Start" type="object" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_done" string="Done" type="object" invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_create_deposit_invoice" string="Create Deposit Invoice" type="object" class="oe_highlight" invisible="state in ('draft', 'cancel') or deposit_invoice_id or not deposit_required"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state in ('draft', 'cancel')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_deposit_invoice" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="not deposit_invoice_id">
                            <div class="o_stat_info">
                                <field name="deposit_amount"/>
                                <span class="o_stat_text">Deposit</span>
                            </div>
                        </button>
<!--                        <button name="%(action_boat)d" type="action" class="oe_stat_button" icon="fa-ship" context="{'default_partner_id': partner_id, 'default_name': boat_id}">-->
<!--                            <field name="boat_id" string="Boat"/>-->
<!--                        </button>-->
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="boat_id"/>
                            <field name="location_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration" widget="statinfo"/>
                            <field name="price_per_day" widget="monetary"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="payment_state" widget="badge"/>
                            <field name="deposit_required"/>
                            <field name="deposit_amount" widget="monetary" invisible="not deposit_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Additional Services" name="services">
                            <field name="service_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="row mt-4">
                        <div class="col-6 offset-6">
                            <table class="table table-sm o_subtotal_footer">
                                <tr>
                                    <td><strong>Rental Subtotal</strong></td>
                                    <td class="text-end">
                                        <field name="amount_total" widget="monetary"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Services</strong></td>
                                    <td class="text-end">
                                        <field name="services_total" widget="monetary"/>
                                    </td>
                                </tr>
                                <tr class="border-top o_subtotal_footer">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end">
                                        <field name="total_amount" widget="monetary" class="oe_subtotal_footer"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_kanban" model="ir.ui.view">
        <field name="name">location.rental.kanban</field>
        <field name="model">location.rental</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <field name="boat_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration"/>
                <field name="amount_total"/>
                <field name="payment_state"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="partner_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-12">
                                            <i class="fa fa-ship me-1" role="img" aria-label="Boat"/>
                                            <field name="boat_id"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <i class="fa fa-map-marker me-1" role="img" aria-label="Location"/>
                                            <field name="location_id"/>
                                        </div>
                                    </div>
                                    <div class="row mt-1">
                                        <div class="col-6">
                                            <i class="fa fa-calendar me-1" role="img" aria-label="Start"/>
                                            <field name="start_date"/>
                                        </div>
                                        <div class="col-6">
                                            <i class="fa fa-calendar me-1" role="img" aria-label="End"/>
                                            <field name="end_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="duration"/> days
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="amount_total" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rental_calendar" model="ir.ui.view">
        <field name="name">location.rental.calendar</field>
        <field name="model">location.rental</field>
        <field name="arch" type="xml">
            <calendar string="Rentals" date_start="start_date" date_stop="end_date" color="location_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="boat_id"/>
                <field name="location_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_rental" model="ir.actions.act_window">
        <field name="name">Rentals</field>
        <field name="res_model">location.rental</field>
        <field name="view_mode">kanban,list,calendar,form</field>
    </record>
</odoo>
