<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="withholding_button" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml"  >
                    <xpath expr="//button[@name='button_draft']" position="after">
                        <field name="withholding_id" invisible="1"/>
                        <button name="action_rs"  type="object" class="oe_highlight" string="Retenue à la Source" invisible="payment_state != 'not_paid'
                          or (state not in ('posted','post') or withholding_id not in ('',None,False))
                          or (move_type not in ('out_invoice', 'in_invoice'))"
                        />
                    </xpath>
            </field>
        </record>
</odoo>